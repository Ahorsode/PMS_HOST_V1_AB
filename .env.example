# Database (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# NextAuth
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Supabase (server writes and client reads)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin panel
HATCHLOG_ADMIN_SESSION_SECRET="your-admin-secret-min-32-chars"

# Desktop license tokens (min 16 chars, keep secret)
HATCHLOG_LICENSE_TOKEN_SECRET="your-license-token-secret"

# Cron endpoints: required, requests without it are rejected
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Public site URL (sitemap, links)
NEXT_PUBLIC_SITE_URL="https://poultryledger.com"

# Optional
# NEXT_PUBLIC_INVOICE_TAX_RATE="0"
# NEXT_PUBLIC_SHOW_USER_DESKTOP_LICENSES="false"
# Set to "true" to let requests through when Upstash is not configured in production
# RATE_LIMIT_FAIL_OPEN="true"
# Set to "true" to run Prisma migrations during non-production builds
# MIGRATE_ON_BUILD="false"

# Sentry (optional)
SENTRY_DSN="https://your-private-sentry-dsn@sentry.io/project"
NEXT_PUBLIC_SENTRY_DSN="https://your-public-sentry-dsn@sentry.io/project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token-for-source-map-uploads"

# Paystack (use sk_test_... keys until your business is approved)
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
